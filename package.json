{
  "name": "ambulance-index",
  "version": "1.0.0",
  "description": "A project with a Node.js Fastify backend and a Svelte frontend",
  "main": "backend/index.js",
  "scripts": {
    "start": "node backend/index.js",
    "dev": "concurrently \"yarn dev:backend\" \"yarn dev:frontend\"",
    "dev:backend": "nodemon backend/index.js",
    "dev:frontend": "cd frontend && yarn dev",
    "build": "cd frontend && yarn build",
    "postinstall": "cd frontend && yarn && cd ../backend && yarn"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.1"
  }
}
